{
  "compilerOptions": {
    "target": "ES2022",
    
    // ✅ תיקון 4: מעבר ל-CommonJS
    "module": "CommonJS", 
    
    // ✅ תיקון 5: מעבר לפתרון מודולים רגיל
    "moduleResolution": "node", 
    
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src", 
    
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true 
  },
  "include": ["src/**/*.ts"], 
  "exclude": ["node_modules"]
}